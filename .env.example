# Example environment file. Copy to .env to use it:
#
#     cp .env.example .env
#
# Everything here is optional. The app runs with sensible defaults and no .env
# at all, which is why the quick start in the README does not mention one.
# Real environment variables take precedence over anything set in .env.
#
# This file is committed. Never put a real secret in it — put those in .env,
# which is git-ignored.


# --- Django ---------------------------------------------------------------

# Only matters if you serve this beyond localhost. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-key

# Leave True for local development. Set to False anywhere public.
DJANGO_DEBUG=True

# Comma-separated. Narrow this from "*" before deploying.
DJANGO_ALLOWED_HOSTS=*


# --- Routing provider -----------------------------------------------------
# Both services are free and need no API key or account.

# "osrm" (default) or "valhalla".
ROUTING_PROVIDER=osrm

# The public OSRM demo server. It is fine for a demo but is explicitly
# non-commercial, capped at ~1 request/second, and offers no uptime
# guarantee. For production, self-host OSRM and point this at it.
OSRM_BASE_URL=https://router.project-osrm.org

# Used automatically if OSRM is unreachable.
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de

ROUTING_TIMEOUT_SECONDS=15

# OpenStreetMap services require a User-Agent that identifies the application
# and gives them a way to make contact. Put a real address here before
# pointing this at any OSM-hosted service in earnest.
USER_AGENT=fuel-route-optimizer/1.0 (contact: you@example.com)


# --- Geocoding ------------------------------------------------------------

# "City, ST" input is resolved offline from data/us_places.csv, so this is
# only consulted for full street addresses.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Set to False to run fully offline. Street addresses then fail with a clear
# message instead of reaching out to the network.
ENABLE_REMOTE_GEOCODING=True


# --- Vehicle defaults -----------------------------------------------------
# The assessment specifies 500 miles and 10 mpg. These are defaults, not
# hard-coded constants; any request can override them per call.

VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10

# How far off the route a station may sit and still count as "on the way".
CORRIDOR_MILES=5

# Consider only the cheapest station per this many miles. Stops otherwise
# bunch up around interchanges. Set to 0 to disable.
CLUSTER_BIN_MILES=25


# --- Cache ----------------------------------------------------------------
# By default the app uses Django's in-process LocMemCache. There is no cache
# server to install or run.

# How long a fetched route stays cached. Prices are a static snapshot, so a
# day is safe.
CACHE_TTL_SECONDS=86400

# OPTIONAL, and off unless you uncomment it. LocMemCache lives inside a single
# process, so under a multi-worker deployment (gunicorn -w 4) each worker keeps
# its own copy and the cache hit rate suffers. Redis gives the workers a shared
# cache. It also needs the driver, which is not a base requirement:
#
#     pip install redis
#
# REDIS_URL=redis://127.0.0.1:6379/0
